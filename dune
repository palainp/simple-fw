(executable
 (name unikernel)
 (modules unikernel rules)
 (public_name simple-fw)
 (modes native)
 (link_flags :standard -cclib "-z solo5-abi=hvt")
 (libraries miou-solo5 miou-solo5-net mirage-crypto-rng-miou-solo5 logs.fmt logs.cli fmt.cli)
 (foreign_stubs
  (language c)
  (names manifest)))

(rule
 (targets manifest.c)
 (enabled_if
  (= %{context_name} "default"))
 (action
  (write-file manifest.c "")))

(rule
 (targets manifest.c)
 (deps manifest.json)
 (enabled_if
  (= %{context_name} "solo5"))
 (action
  (run solo5-elftool gen-manifest manifest.json manifest.c)))

(rule
 (targets manifest.json)
 (enabled_if
  (= %{context_name} "solo5"))
 (action
  (with-stdout-to
   manifest.json
   (run %{exe:unikernel.exe}))))

(vendored_dirs bstr.dev miou-solo5.dev miou-solo5-net.dev mirage-crypto-rng-miou-solo5.dev)
